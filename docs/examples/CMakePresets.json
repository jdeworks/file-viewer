{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug build",
      "description": "Debug configuration with symbols",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release build",
      "description": "Optimized release build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release"
    },
    {
      "name": "ci",
      "displayName": "CI build",
      "description": "Continuous integration preset",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-debug",
      "displayName": "Build debug",
      "configurePreset": "debug"
    },
    {
      "name": "build-release",
      "displayName": "Build release",
      "configurePreset": "release"
    },
    {
      "name": "build-ci",
      "displayName": "Build CI",
      "configurePreset": "ci"
    }
  ],
  "testPresets": [
    {
      "name": "test-debug",
      "displayName": "Test debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "test-ci",
      "displayName": "Test CI",
      "configurePreset": "ci",
      "output": { "outputOnFailure": true }
    }
  ],
  "workflowPresets": [
    {
      "name": "ci-workflow",
      "displayName": "Full CI workflow",
      "description": "Configure, build, and test in CI",
      "steps": [
        { "type": "configure", "name": "ci" },
        { "type": "build", "name": "build-ci" },
        { "type": "test", "name": "test-ci" }
      ]
    }
  ]
}

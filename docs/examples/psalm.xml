<?xml version="1.0"?>
<psalm
    errorLevel="3"
    phpVersion="8.1"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedPsalmSuppress="true"
    totallyTyped="false"
>
    <projectFiles>
        <directory name="src" />
        <directory name="lib" />
        <file name="bootstrap/app.php" />
        <ignoreFiles>
            <directory name="vendor" />
            <directory name="tests/fixtures" />
        </ignoreFiles>
    </projectFiles>

    <stubs>
        <file name="stubs/custom-functions.phpstub" />
        <file name="stubs/legacy-api.phpstub" />
    </stubs>

    <plugins>
        <pluginClass class="Psalm\Plugin\Symfony\SymfonyPlugin" />
        <pluginClass class="Psalm\PhpUnitPlugin\Plugin" />
    </plugins>

    <forbiddenFunctions>
        <function name="var_dump" />
        <function name="die" />
        <function name="exit" />
        <function name="dd" />
    </forbiddenFunctions>

    <issueHandlers>
        <MissingReturnType errorLevel="info" />
        <MissingParamType errorLevel="info" />
        <PropertyNotSetInConstructor errorLevel="suppress" />
        <UnusedVariable errorLevel="info" />
        <MixedAssignment errorLevel="suppress" />
        <MixedArgumentTypeCoercion errorLevel="info" />
    </issueHandlers>
</psalm>

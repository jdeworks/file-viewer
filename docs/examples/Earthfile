VERSION 0.8

build:
    FROM node:20-alpine
    WORKDIR /app
    COPY package*.json ./
    RUN npm ci
    COPY . .
    RUN npm run build
    SAVE ARTIFACT dist /dist

test:
    FROM +build
    RUN npm test

docker:
    FROM nginx:alpine
    COPY +build/dist /usr/share/nginx/html
    EXPOSE 80
    SAVE IMAGE my-app:latest

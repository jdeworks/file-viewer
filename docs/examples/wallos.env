# Wallos - Self-hosted subscription tracker
APP_NAME=Wallos
APP_URL=http://wallos.example.com
APP_ENV=production

# System
PUID=1000
PGID=1000
TZ=America/New_York

# Database
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=/var/www/html/database/wallos.db
DB_USERNAME=wallos
DB_PASSWORD=changeme

# Currency
CURRENCY=USD
CURRENCY_SYMBOL=$

# Features
SUBSCRIPTION_RENEW_DATE=1
TRIAL_NOTIF_DAYS=3

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=notifications@example.com
MAIL_PASSWORD=secret
MAIL_FROM_ADDRESS=wallos@example.com
MAIL_FROM_NAME=Wallos

# Locale
LOCALE=en
DATE_FORMAT=dd/mm/yyyy

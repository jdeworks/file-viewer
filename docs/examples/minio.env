# MinIO Object Storage Configuration
# https://min.io/docs/minio/linux/reference/minio-server/settings.html

# Identity
MINIO_VOLUMES=/data/minio
MINIO_SITE_NAME=my-minio
MINIO_SITE_REGION=us-east-1

# Authentication
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=supersecretpassword123

# Console
MINIO_CONSOLE_ADDRESS=:9001
MINIO_BROWSER=on

# TLS
# MINIO_CERT_FILE=/etc/minio/certs/public.crt
# MINIO_KEY_FILE=/etc/minio/certs/private.key

# Erasure Coding
# MINIO_ERASURE_SET_DRIVE_COUNT=4

# Prometheus
MINIO_PROMETHEUS_AUTH_TYPE=public

dnl configure.ac — Autoconf input for myproject
dnl Generated by autoconf 2.71

AC_PREREQ([2.69])
AC_INIT([myproject], [1.4.2], [bugs@example.com])
AC_CONFIG_SRCDIR([src/main.c])
AC_CONFIG_HEADERS([config.h])
AC_CONFIG_AUX_DIR([build-aux])
AC_CONFIG_MACRO_DIR([m4])

AM_INIT_AUTOMAKE([foreign -Wall -Werror])
AM_SILENT_RULES([yes])

dnl ── Compiler checks ──────────────────────────────────────────
AC_PROG_CC
AC_PROG_CC_STDC
AC_PROG_CXX
AC_PROG_INSTALL
AC_PROG_MAKE_SET
AC_PROG_RANLIB

dnl ── libtool ──────────────────────────────────────────────────
LT_INIT

dnl ── Header checks ────────────────────────────────────────────
AC_CHECK_HEADERS([stdint.h stdlib.h string.h unistd.h sys/time.h])

dnl ── Type checks ──────────────────────────────────────────────
AC_TYPE_SIZE_T
AC_TYPE_UINT8_T
AC_TYPE_UINT32_T
AC_TYPE_INT64_T

dnl ── Function checks ──────────────────────────────────────────
AC_CHECK_FUNCS([memset strtol strtod clock_gettime])

dnl ── Library checks ───────────────────────────────────────────
AC_CHECK_LIB([m], [sqrt])
AC_CHECK_LIB([pthread], [pthread_create],
    [LIBS="-lpthread $LIBS"],
    [AC_MSG_ERROR([pthread not found])])

dnl ── Optional zlib support ────────────────────────────────────
AC_ARG_WITH([zlib],
    [AS_HELP_STRING([--with-zlib], [enable zlib compression support])],
    [with_zlib=$withval], [with_zlib=yes])
AS_IF([test "x$with_zlib" != "xno"],
    [AC_CHECK_LIB([z], [deflate],
        [AC_DEFINE([HAVE_ZLIB], [1], [Define if zlib is available])
         LIBS="-lz $LIBS"],
        [AC_MSG_WARN([zlib not found; compression disabled])])])

dnl ── Custom M4 macros ─────────────────────────────────────────
m4_include([m4/ax_pthread.m4])
m4_include([m4/ax_check_compile_flag.m4])

define([MY_VERSION_MAJOR], [1])
define([MY_VERSION_MINOR], [4])
define([MY_VERSION_PATCH], [2])

dnl ── Output ───────────────────────────────────────────────────
AC_CONFIG_FILES([
    Makefile
    src/Makefile
    tests/Makefile
    docs/Makefile
    myproject.pc
])
AC_OUTPUT

AC_MSG_NOTICE([

  myproject v]MY_VERSION_MAJOR[.]MY_VERSION_MINOR[.]MY_VERSION_PATCH[ configured:

    Prefix:      $prefix
    CC:          $CC
    CFLAGS:      $CFLAGS
    zlib:        $with_zlib
])

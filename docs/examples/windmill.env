# Windmill environment configuration
# https://www.windmill.dev/docs/advanced/self-host

DATABASE_URL=postgres://windmill:windmill@localhost:5432/windmill

BASE_URL=https://windmill.example.com
COOKIE_DOMAIN=example.com

# JWT secret for token signing
JWT_SECRET=supersecretjwtsecret

# Server mode: server | worker | standalone
MODE=standalone

# Metrics prometheus endpoint
METRICS_ADDR=0.0.0.0:8001

# Number of worker threads
NUM_WORKERS=3

# Tags used for worker routing
WORKER_TAGS=deno,python3,go,bash,dependency

# Disable the nsjail sandbox (set true only if nsjail is unavailable)
DISABLE_NSJAIL=false

# Keep job directories after execution for debugging
KEEP_JOB_DIR=false

# Runtime binary paths
DENO_PATH=/usr/bin/deno
PYTHON_PATH=/usr/bin/python3
GO_PATH=/usr/bin/go
RUST_PATH=/usr/bin/cargo
BASH_PATH=/bin/bash

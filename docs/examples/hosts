# /etc/hosts — system hostname resolution
# This file is managed locally; changes take effect immediately.

# Loopback entries
127.0.0.1   localhost
127.0.0.1   localhost.localdomain
::1         localhost ip6-localhost ip6-loopback
127.0.1.1   myhost.local myhost

# Development services
127.0.0.1   dev.example.com
127.0.0.1   api.example.com
127.0.0.1   staging.example.com

# Block advertising/tracking domains
0.0.0.0     ads.tracker.net
0.0.0.0     telemetry.vendor.com


// Sample KDL document — project configuration
project "my-app" version="1.0.0" {
  description "A sample application"
  license "MIT"
  homepage "https://example.com/my-app"
}

dependencies {
  // Runtime dependencies
  package "express" version="^4.18.0"
  package "zod" version="^3.22.0"
  package "dotenv" version="^16.0.0"
}

dev-dependencies {
  package "typescript" version="^5.3.0"
  package "vitest" version="^1.0.0"
  package "eslint" version="^8.55.0"
}

scripts {
  build "tsc -p tsconfig.json"
  dev "node --watch dist/index.js"
  test "vitest run"
  lint "eslint src"
}

config {
  port 3000
  host "0.0.0.0"
  log-level "info"

  database {
    driver "postgres"
    pool-size 10
    timeout 5000
  }
}

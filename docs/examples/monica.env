# Monica Personal CRM Environment Configuration
# https://github.com/monicahq/monica

APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_ENV=production
APP_DEBUG=false
APP_URL=https://monica.example.com

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=monica
DB_USERNAME=monica_user
DB_PASSWORD=supersecretpassword

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mail.example.com
MAIL_PORT=587
MAIL_USERNAME=monica@example.com
MAIL_PASSWORD=mailpassword
MAIL_FROM_ADDRESS=monica@example.com
MAIL_FROM_NAME=Monica

# Storage Limits
DEFAULT_MAX_STORAGE_SIZE=512
DEFAULT_MAX_UPLOAD_SIZE=10240

# Features
MFA_ENABLED=true
SUBSCRIPTION_ENABLED=false
ALLOW_STATISTICS_CRAWLING=false

# msmtp configuration file
# Default settings for all accounts
defaults
auth           on
tls            on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile        ~/.msmtp.log

# Gmail account
account        gmail
host           smtp.gmail.com
port           587
tls_starttls   on
from           user@gmail.com
user           user@gmail.com
password       app_password_here

# Fastmail account
account        fastmail
host           smtp.fastmail.com
port           465
tls            on
tls_starttls   off
from           user@fastmail.com
user           user@fastmail.com
password       fastmail_app_password

# Work account
account        work
host           mail.company.example
port           587
tls_starttls   on
from           jane.smith@company.example
user           jane.smith@company.example
password       work_smtp_password
auth           login

# Set default account
account default : gmail

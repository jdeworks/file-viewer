# Mealie Recipe Manager Configuration
# https://docs.mealie.io/documentation/getting-started/installation/

# Application
BASE_URL=https://mealie.example.com
TOKEN_TIME=48

# Workers
MAX_WORKERS=2
WEB_CONCURRENCY=2

# Database
DB_ENGINE=postgres
POSTGRES_SERVER=db
POSTGRES_DB=mealie
POSTGRES_USER=mealie
POSTGRES_PASSWORD=supersecretpassword

# Email / SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_AUTH_STRATEGY=TLS
SMTP_FROM_NAME=Mealie
SMTP_FROM_EMAIL=mealie@example.com
SMTP_PASSWORD=emailpassword

# Default Admin Account
DEFAULT_EMAIL=admin@example.com
DEFAULT_PASSWORD=changeMe123

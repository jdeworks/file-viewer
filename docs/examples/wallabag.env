WALLABAG_URL=https://wallabag.example.com
SYMFONY__ENV__LOCALE=en
SYMFONY__ENV__FOSUSER_REGISTRATION=false
SYMFONY__ENV__FOSUSER_CONFIRMATION=true

SYMFONY__ENV__DATABASE_DRIVER=pdo_pgsql
SYMFONY__ENV__DATABASE_HOST=db
SYMFONY__ENV__DATABASE_PORT=5432
SYMFONY__ENV__DATABASE_NAME=wallabag
SYMFONY__ENV__DATABASE_USER=wallabag
SYMFONY__ENV__DATABASE_PASSWORD=secret_db_password

SYMFONY__ENV__SECRET=super_secret_symfony_key_here
SYMFONY__ENV__TWOFACTOR_AUTH=true

SYMFONY__ENV__MAILER_TRANSPORT=smtp
SYMFONY__ENV__MAILER_HOST=smtp.example.com
SYMFONY__ENV__MAILER_USER=noreply@example.com
SYMFONY__ENV__MAILER_PASSWORD=smtp_password

SYMFONY__ENV__REDIS_HOST=redis
SYMFONY__ENV__REDIS_PASSWORD=

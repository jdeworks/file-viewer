%% sys.config - Erlang/OTP runtime configuration
[
  {kernel, [
    {logger_level, info},
    {error_logger, false}
  ]},

  {sasl, [
    {sasl_error_logger, false},
    {errlog_type, error}
  ]},

  {lager, [
    {handlers, [
      {lager_console_backend, [{level, info}]},
      {lager_file_backend, [{file, "log/error.log"}, {level, error}]},
      {lager_file_backend, [{file, "log/app.log"}, {level, info}]}
    ]},
    {error_logger_hwm, 200},
    {async_threshold, 20}
  ]},

  {myapp, [
    {port, 8080},
    {host, <<"0.0.0.0">>},
    {database_url, <<"postgres://localhost/myapp_prod">>},
    {pool_size, 10},
    {max_connections, 100},
    {cache_ttl, 3600},
    {debug_mode, false},
    {secret_key_base, <<"super-secret-key-change-in-production">>}
  ]},

  {ranch, [
    {max_connections, 1024}
  ]},

  {hackney, [
    {mod_metrics, folsom}
  ]}
].

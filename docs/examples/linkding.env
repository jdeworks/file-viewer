## Linkding Bookmark Manager Configuration
## https://github.com/sissbruecker/linkding/blob/master/docs/Options.md

# Admin user
LD_SUPERUSER_NAME=admin
LD_SUPERUSER_PASSWORD=supersecretpassword

# Server
LD_SERVER_PORT=9090
LD_CONTEXT_PATH=/bookmarks
CSRF_TRUSTED_ORIGINS=https://bookmarks.example.com

# Database (PostgreSQL)
LD_DB_ENGINE=postgres
LD_DB_HOST=localhost
LD_DB_PORT=5432
LD_DB_DATABASE=linkding
LD_DB_USER=linkding
LD_DB_PASSWORD=dbpassword123

# Auth Proxy
LD_ENABLE_AUTH_PROXY=false
LD_AUTH_PROXY_USERNAME_HEADER=HTTP_REMOTE_USER

# Features
LD_DISABLE_BACKGROUND_TASKS=false
LD_DISABLE_URL_VALIDATION=false
LD_REQUEST_TIMEOUT=60

## Invoice Ninja Self-Hosted Configuration
## https://invoiceninja.github.io/en/self-host-installation/

# Application
APP_URL=https://invoices.example.com
APP_ENV=production
APP_DEBUG=false

NINJA_ENVIRONMENT=selfhosted

# Security
APP_KEY=base64:Z2VuZXJhdGVkc2VjcmV0a2V5Zm9ySW52b2ljZU5pbmph

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=invoiceninja
DB_USERNAME=ninja
DB_PASSWORD=supersecretdbpassword

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=invoices@example.com
MAIL_PASSWORD=smtppassword123
MAIL_FROM_ADDRESS=invoices@example.com
MAIL_FROM_NAME="Invoice Ninja"
MAIL_ENCRYPTION=tls

# File Storage (local)
FILESYSTEM_DRIVER=local

# PDF Generation
PDF_GENERATOR=snappdf

# Queue
QUEUE_CONNECTION=sync

# Cache / Session
CACHE_DRIVER=file
SESSION_DRIVER=file

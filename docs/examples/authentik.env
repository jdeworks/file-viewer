# Authentik identity provider environment configuration
# https://docs.goauthentik.io/docs/installation/docker-compose

AUTHENTIK_SECRET_KEY=a_very_long_and_random_secret_key_replace_in_production

# PostgreSQL database
AUTHENTIK_POSTGRESQL__HOST=db
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=a_very_strong_database_password
AUTHENTIK_POSTGRESQL__PORT=5432

# Redis
AUTHENTIK_REDIS__HOST=redis
AUTHENTIK_REDIS__PORT=6379
AUTHENTIK_REDIS__PASSWORD=

# Email (SMTP)
AUTHENTIK_EMAIL__HOST=smtp.example.com
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=authentik@example.com
AUTHENTIK_EMAIL__PASSWORD=smtp_password_here
AUTHENTIK_EMAIL__FROM=authentik@example.com
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__USE_SSL=false

# Error reporting (Sentry)
AUTHENTIK_ERROR_REPORTING__ENABLED=false

# Listen addresses
AUTHENTIK_LISTEN__HTTP=0.0.0.0:9000
AUTHENTIK_LISTEN__HTTPS=0.0.0.0:9443
AUTHENTIK_LISTEN__METRICS=0.0.0.0:9300

## Vaultwarden Configuration
## https://github.com/dani-garcia/vaultwarden/wiki/Configuration-overview

DOMAIN=https://vault.example.com

## Rocket (web server) settings
ROCKET_PORT=8080
ROCKET_WORKERS=10
ROCKET_ADDRESS=0.0.0.0

## Signup and access control
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=true
SIGNUPS_VERIFY=true

## Admin panel (set to a secure random token)
ADMIN_TOKEN=YFz2p8Kj3n9vQw7X1mLs5eD6cR0tUo4iAhBxNgJy

## Database
DATABASE_URL=postgresql://vaultwarden:secretpassword@localhost:5432/vaultwarden

## WebSocket notifications
WEBSOCKET_ENABLED=true

## SMTP / Email
SMTP_HOST=smtp.example.com
SMTP_FROM=vault@example.com
SMTP_FROM_NAME=Vaultwarden
SMTP_PORT=587
SMTP_SSL=true
SMTP_USERNAME=vault@example.com
SMTP_PASSWORD=emailpassword123

## Logging
LOG_FILE=/var/log/vaultwarden/vaultwarden.log
LOG_LEVEL=info

# Maybe Finance Environment Configuration
# Self-hosted personal finance application (Rails)

# App
DOMAIN_URL=https://finance.example.com
RAILS_ENV=production
PORT=3000

# Security
SECRET_KEY_BASE=very-long-secret-key-base-value-abc123def456ghi789jkl012mno345pqr678stu901vwx234yz
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=deterministic-encryption-key-abc123def456
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=derivation-salt-value-xyz789abc012def345ghi678
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=primary-encryption-key-mno123pqr456stu789vwx012

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=maybe_production
DB_USER=maybe
DB_PASS=securedbpassword123

# Email
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=smtp-secret-password
SMTP_FROM_ADDRESS=noreply@example.com
REQUIRE_EMAIL_CONFIRMATION=true

# Features
SELF_HOSTED_TEAM=true
SIGNUPS_DISABLED=false

# Synth
SYNTH_ID=synth-user-id-abc123
SYNTH_SECRET=synth-secret-key-xyz789

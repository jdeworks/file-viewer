{
  "schema": "src/schema.graphql",
  "documents": ["src/**/*.{graphql,gql}", "src/**/*.ts"],
  "extensions": {
    "codegen": {
      "generates": {
        "src/generated/types.ts": {
          "plugins": ["typescript", "typescript-operations"]
        }
      }
    },
    "endpoints": {
      "default": {
        "url": "http://localhost:4000/graphql",
        "headers": {
          "Content-Type": "application/json"
        }
      }
    }
  }
}

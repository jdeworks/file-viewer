# BookStack Environment Configuration
# https://www.bookstackapp.com/docs/admin/installation/

APP_KEY=base64:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx=
APP_URL=https://bookstack.example.com
APP_ENV=production
APP_DEBUG=false
APP_LANG=en
APP_AUTO_LANG_PUBLIC=false

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bookstack
DB_USERNAME=bookstack_user
DB_PASSWORD=supersecretpassword

# Cache, Session & Queue
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

# Mail / Email Configuration
MAIL_DRIVER=smtp
MAIL_HOST=mail.example.com
MAIL_PORT=587
MAIL_FROM=bookstack@example.com
MAIL_FROM_NAME=BookStack
MAIL_USERNAME=bookstack@example.com
MAIL_PASSWORD=mailpassword123
MAIL_ENCRYPTION=tls

# Auth Method (standard/ldap/saml2/oidc)
AUTH_METHOD=standard

# File Storage
STORAGE_TYPE=local
STORAGE_S3_KEY=AKIAIOSFODNN7EXAMPLE
STORAGE_S3_SECRET=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
STORAGE_S3_BUCKET=my-bookstack-bucket
STORAGE_S3_REGION=us-east-1

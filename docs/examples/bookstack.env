MAIL_HOST=mail.example.com
MAIL_PORT=587
MAIL_FROM=bookstack@example.com
MAIL_USERNAME=bookstack@example.com
MAIL_PASSWORD=mailpassword123

# Cache, Session & Queue
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync

# File Storage
STORAGE_TYPE=local
STORAGE_S3_KEY=AKIAIOSFODNN7EXAMPLE
STORAGE_S3_SECRET=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weeklyNonOfficeHours",
    ":dependencyDashboard",
    ":semanticCommits",
    "group:monorepos"
  ],
  "automerge": false,
  "automergeType": "pr",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "assignees": ["@janesmith"],
  "reviewers": ["@bobsmith"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchPackagePatterns": ["^@types/"],
      "groupName": "DefinitelyTyped"
    },
    {
      "matchManagers": ["docker"],
      "enabled": true
    },
    {
      "matchUpdateTypes": ["major"],
      "labels": ["breaking-change", "dependencies"],
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": true,
    "labels": ["security"]
  },
  "schedule": ["before 9am on monday"]
}

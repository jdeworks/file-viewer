## Woodpecker CI Agent Configuration
## https://woodpecker-ci.org/docs/administration/agent-config

# gRPC server address of the Woodpecker server
WOODPECKER_SERVER=woodpecker.example.com:9000

# Shared secret between the server and agent (must match server config)
WOODPECKER_AGENT_SECRET=supersecretagenttoken123

# Number of pipelines this agent can run in parallel
WOODPECKER_MAX_PROCS=4

# Log level (trace, debug, info, warn, error)
WOODPECKER_LOG_LEVEL=info

# Pipeline backend (docker, local, kubernetes)
WOODPECKER_BACKEND=docker

# Docker network to attach pipeline containers to
WOODPECKER_BACKEND_DOCKER_NETWORK=woodpecker

# Additional volumes to mount into pipeline containers
WOODPECKER_BACKEND_DOCKER_VOLUMES=/etc/ssl/certs:/etc/ssl/certs:ro

# Agent capability labels (used to route pipelines to specific agents)
WOODPECKER_FILTER_LABELS=platform=linux/amd64,size=large

# Hostname reported to the server (defaults to OS hostname)
WOODPECKER_HOSTNAME=agent-01.example.com

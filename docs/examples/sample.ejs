<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <%# Main navigation header %>
  <header class="site-header">
    <h1><%= siteName %></h1>
    <nav>
      <% navItems.forEach(function(item) { %>
        <a href="<%= item.url %>" class="<%= item.active ? 'active' : '' %>">
          <%= item.label %>
        </a>
      <% }); %>
    </nav>
  </header>

  <main class="container">
    <%# Hero section %>
    <section class="hero">
      <h2>Welcome, <%= user.name %>!</h2>
      <% if (user.isAdmin) { %>
        <span class="badge badge-admin">Administrator</span>
      <% } %>
      <p class="lead"><%- introHtml %></p>
    </section>

    <%# Products grid %>
    <section class="products">
      <h3>Featured Products</h3>
      <% if (products && products.length > 0) { %>
        <div class="product-grid">
          <% products.forEach(function(product) { %>
            <div class="product-card">
              <img src="<%= product.imageUrl %>" alt="<%= product.name %>">
              <h4><%= product.name %></h4>
              <p><%- product.descriptionHtml %></p>
              <span class="price">$<%= product.price.toFixed(2) %></span>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <p class="empty-state">No products available.</p>
      <% } %>
    </section>

    <%# Sidebar partial %>
    <%- include('partials/sidebar', { categories: categories }) %>
  </main>

  <footer class="site-footer">
    <p>&copy; <%= year %> <%= siteName %>. All rights reserved.</p>
    <%# Social links %>
    <% socialLinks.forEach(function(link) { %>
      <a href="<%= link.url %>" target="_blank" rel="noopener"><%= link.platform %></a>
    <% }); %>
  </footer>

  <script src="/js/app.js"></script>
  <% if (debugMode) { %>
    <%# Debug panel — only shown in development %>
    <%- include('partials/debug-panel', { data: debugData }) %>
  <% } %>
</body>
</html>

# changedetection.io configuration
# https://github.com/dgtlmoon/changedetection.io

BASE_URL=https://changedetection.example.com
PORT=5000

# Browser automation
PLAYWRIGHT_DRIVER_URL=ws://playwright-chrome:3000/
WEBDRIVER_URL=http://selenium:4444/wd/hub

# Behavior
HIDE_REFERER=true
FETCH_WORKERS=10
MINIMUM_SECONDS_RECHECK_TIME=60
MAX_WATCH_SECONDS_RECHECK_TIME=86400

# Notifications
NOTIFICATION_TITLE=changedetection.io Alert

# Proxy (no credentials in this example)
# HTTP_PROXY=http://proxy.example.com:3128
# HTTPS_PROXY=https://proxy.example.com:3128

# Auth (hashed login password — set via UI)
# SALTED_PASS=sha256$somesaltedhashvalue

# Logging
LOGGER_LEVEL=INFO

# Browser screenshot settings
SCREENSHOT_WIDTH=1280
SCREENSHOT_QUALITY=72
BROWSER_STEPS_SCREENSHOT_QUALITY=72

# Cache (optional Redis)
# REDIS_URL=redis://localhost:6379/0

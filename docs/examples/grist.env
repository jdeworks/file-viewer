# Grist self-hosted configuration
# https://support.getgrist.com/self-managed/

# App
APP_HOME_URL=https://grist.example.com
GRIST_SINGLE_ORG=myteam
GRIST_DEFAULT_EMAIL=admin@example.com
GRIST_PAGE_TITLE_SUFFIX= — My Grist

# Auth
GRIST_SESSION_SECRET=a-very-long-random-secret-string-change-me
GRIST_FORCE_LOGIN=false

# Database (SQLite)
TYPEORM_TYPE=sqlite
TYPEORM_DATABASE=/persist/grist.db

# Storage
GRIST_DATA_DIR=/persist
GRIST_DOCS_DIR=/persist/docs

# Sandbox
GRIST_SANDBOX_FLAVOR=unsandboxed

# Email (SendGrid)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
GRIST_SUPPORT_EMAIL=support@example.com

# Limits
GRIST_MAX_UPLOAD_ATTACHMENT_MB=50
GRIST_MAX_UPLOAD_IMPORT_MB=300

# Telemetry
GRIST_TELEMETRY_LEVEL=off

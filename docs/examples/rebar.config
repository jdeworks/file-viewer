{minimum_otp_vsn, "25.0"}.

{deps, [
    {cowboy, "2.10.0"},
    {cowlib, "2.12.1"},
    {ranch, "2.1.0"},
    {jsx, "3.1.0"},
    {lager, {git, "https://github.com/erlang-lager/lager.git", {tag, "3.9.2"}}},
    {eredis, "1.7.1"},
    {hackney, "1.20.1"},
    {poolboy, "1.5.2"},
    {prometheus, "4.10.0"}
]}.

{plugins, [
    rebar3_hex,
    rebar3_auto,
    {rebar3_lint, {git, "https://github.com/project-fifo/rebar3_lint.git", {tag, "0.1.10"}}}
]}.

{erl_opts, [debug_info, {parse_transform, lager_transform}]}.

{profiles, [
    {prod, [
        {erl_opts, [no_debug_info, warnings_as_errors]},
        {relx, [{dev_mode, false}, {include_erts, true}]}
    ]},
    {test, [
        {deps, [{meck, "0.9.2"}, {proper, "1.4.0"}]},
        {erl_opts, [debug_info]}
    ]},
    {dev, [
        {erl_opts, [debug_info, {d, 'DEV'}]}
    ]}
]}.

{dialyzer, [
    {warnings, [no_return, unmatched_returns, error_handling]},
    {plt_apps, all_deps},
    {plt_extra_apps, [crypto, ssl]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    exports_not_used
]}.

{cover_enabled, true}.

{% extends "base/deployment.yaml.j2" %}

{% block header %}
# Kubernetes Deployment generated by Ansible
# Environment: {{ env | upper }}
# Generated: {{ ansible_date_time.iso8601 }}
{% endblock %}

{% block manifest %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ app_name | lower | replace('_', '-') }}
  namespace: {{ namespace | default('default') }}
  labels:
    app: {{ app_name }}
    env: {{ env }}
    version: {{ app_version | default('latest') }}
    managed-by: ansible
  annotations:
    deployment.kubernetes.io/revision: "{{ revision | string }}"
{% if extra_annotations is defined %}
{% for key, value in extra_annotations.items() %}
    {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
spec:
  replicas: {{ replicas | default(2) }}
  selector:
    matchLabels:
      app: {{ app_name }}
  template:
    metadata:
      labels:
        app: {{ app_name }}
        version: {{ app_version | default('latest') }}
    spec:
      containers:
        - name: {{ app_name }}
          image: {{ image_registry }}/{{ image_name }}:{{ image_tag | default('latest') }}
          ports:
            - containerPort: {{ container_port | default(8080) }}
          env:
{% for env_var in environment_vars %}
            - name: {{ env_var.name }}
              {% if env_var.secret is defined and env_var.secret %}
              valueFrom:
                secretKeyRef:
                  name: {{ app_name }}-secrets
                  key: {{ env_var.name | lower }}
              {% else %}
              value: "{{ env_var.value }}"
              {% endif %}
{% endfor %}
          resources:
            requests:
              cpu: {{ cpu_request | default('100m') }}
              memory: {{ memory_request | default('128Mi') }}
            limits:
              cpu: {{ cpu_limit | default('500m') }}
              memory: {{ memory_limit | default('512Mi') }}
{% if health_check is defined %}
          livenessProbe:
            httpGet:
              path: {{ health_check.path | default('/health') }}
              port: {{ container_port | default(8080) }}
            initialDelaySeconds: {{ health_check.initial_delay | default(30) }}
            periodSeconds: {{ health_check.period | default(10) }}
{% endif %}
{% endblock %}

{% block service %}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ app_name }}-svc
  namespace: {{ namespace | default('default') }}
spec:
  selector:
    app: {{ app_name }}
  ports:
    - protocol: TCP
      port: 80
      targetPort: {{ container_port | default(8080) }}
  type: {{ service_type | default('ClusterIP') }}
{% endblock %}

{% import "macros/labels.j2" as labels %}
{% include "snippets/resource-quota.yaml.j2" ignore missing %}
{# End of generated deployment manifest #}

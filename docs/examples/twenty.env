## Twenty CRM Configuration
## https://twenty.com/developers/section/self-hosting/self-hosting-var

# App
FRONT_BASE_URL=https://twenty.example.com
SERVER_URL=https://api.twenty.example.com

# Sign-in
SIGN_IN_PREFILLED=false

## Auth tokens
ACCESS_TOKEN_SECRET=replace-with-a-random-secure-secret
LOGIN_TOKEN_SECRET=replace-with-a-random-secure-secret
REFRESH_TOKEN_SECRET=replace-with-a-random-secure-secret
FILE_TOKEN_SECRET=replace-with-a-random-secure-secret

## Database
PG_DATABASE_URL=postgresql://twenty:secretpassword@localhost:5432/twenty

## Redis
REDIS_URL=redis://:redispassword@localhost:6379

## Storage
STORAGE_TYPE=s3
STORAGE_S3_REGION=us-east-1
STORAGE_S3_NAME=twenty-storage
STORAGE_S3_ENDPOINT=https://s3.amazonaws.com

## Email
EMAIL_SYSTEM_ADDRESS=noreply@twenty.example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=twenty@example.com
EMAIL_PASSWORD=email-password-here

## Gmail OAuth (for inbox integration)
GMAIL_MESSAGING_PROJECT_CLIENT_ID=123456789-abcdef.apps.googleusercontent.com
GMAIL_MESSAGING_PROJECT_CLIENT_SECRET=GOCSPX-gmail-secret-here

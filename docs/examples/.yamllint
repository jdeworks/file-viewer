extends: default

rules:
  line-length:
    max: 120
    level: warning
    allow-non-breakable-words: true
  comments:
    require-starting-space: true
    min-spaces-from-content: 1
  truthy:
    allowed-values: [true, false]
    check-keys: true
  document-start:
    present: false
  indentation:
    spaces: 2
    indent-sequences: true
  empty-lines:
    max: 2

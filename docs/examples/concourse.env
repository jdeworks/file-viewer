# Concourse CI Web Node Configuration
# https://concourse-ci.org/concourse-web.html

# ── Server ──────────────────────────────────────────────────────────────────
CONCOURSE_EXTERNAL_URL=https://ci.example.com
CONCOURSE_BIND_IP=0.0.0.0
CONCOURSE_BIND_PORT=8080

# ── Database ─────────────────────────────────────────────────────────────────
CONCOURSE_POSTGRES_HOST=postgres.internal
CONCOURSE_POSTGRES_PORT=5432
CONCOURSE_POSTGRES_DATABASE=concourse
CONCOURSE_POSTGRES_USER=concourse_user
CONCOURSE_POSTGRES_PASSWORD=sup3rs3cr3tpw
CONCOURSE_POSTGRES_SSLMODE=require

# ── Auth: Local Users ────────────────────────────────────────────────────────
CONCOURSE_ADD_LOCAL_USER=admin:adm1np@ssw0rd

# ── Auth: GitHub OAuth ───────────────────────────────────────────────────────
CONCOURSE_GITHUB_CLIENT_ID=Iv1.deadbeefcafe1234
CONCOURSE_GITHUB_CLIENT_SECRET=ghsec_super_secret_value_here

# ── Auth: OIDC ───────────────────────────────────────────────────────────────
CONCOURSE_OIDC_CLIENT_ID=concourse-ci
CONCOURSE_OIDC_CLIENT_SECRET=oidc_client_secret_value
CONCOURSE_OIDC_ISSUER=https://dex.example.com

# ── Keys ─────────────────────────────────────────────────────────────────────
CONCOURSE_SESSION_SIGNING_KEY=/etc/concourse/session_signing_key
CONCOURSE_TSA_HOST_KEY=/etc/concourse/tsa_host_key
CONCOURSE_TSA_AUTHORIZED_KEYS=/etc/concourse/authorized_worker_keys

# ── Worker ───────────────────────────────────────────────────────────────────
CONCOURSE_WORK_DIR=/var/lib/concourse
CONCOURSE_RUNTIME=containerd

# ── TLS ──────────────────────────────────────────────────────────────────────
CONCOURSE_TLS_CERT=/etc/concourse/tls/server.crt
CONCOURSE_TLS_KEY=/etc/concourse/tls/server.key

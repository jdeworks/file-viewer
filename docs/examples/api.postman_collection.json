{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "My API Collection",
    "description": "REST API endpoints for the application",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": { "method": "POST", "url": "{{BASE_URL}}/auth/login" }
        },
        {
          "name": "Refresh Token",
          "request": { "method": "POST", "url": "{{BASE_URL}}/auth/refresh" }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List Users",
          "request": { "method": "GET", "url": "{{BASE_URL}}/users" }
        },
        {
          "name": "Get User",
          "request": { "method": "GET", "url": "{{BASE_URL}}/users/:id" }
        },
        {
          "name": "Create User",
          "request": { "method": "POST", "url": "{{BASE_URL}}/users" }
        },
        {
          "name": "Update User",
          "request": { "method": "PUT", "url": "{{BASE_URL}}/users/:id" }
        },
        {
          "name": "Delete User",
          "request": { "method": "DELETE", "url": "{{BASE_URL}}/users/:id" }
        }
      ]
    },
    {
      "name": "Health Check",
      "request": { "method": "GET", "url": "{{BASE_URL}}/health" }
    }
  ],
  "variable": [
    { "key": "BASE_URL", "value": "https://api.example.com/v1" },
    { "key": "API_KEY", "value": "" }
  ]
}

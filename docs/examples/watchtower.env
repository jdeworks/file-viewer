# Watchtower – automatic Docker container updater
# https://containrrr.dev/watchtower/

# ── Schedule ────────────────────────────────────────────────────────────────
# Run every day at 04:00 AM UTC (cron expression)
WATCHTOWER_SCHEDULE=0 0 4 * * *

# Alternatively use a poll interval in seconds (comment out SCHEDULE when using this)
# WATCHTOWER_POLL_INTERVAL=300

# Run only once and exit (useful for CI/CD pipelines)
WATCHTOWER_RUN_ONCE=false

# ── Behavior ────────────────────────────────────────────────────────────────
# Remove old images after updating containers
WATCHTOWER_CLEANUP=true

# Check and update stopped containers too
WATCHTOWER_INCLUDE_STOPPED=false

# Restart containers that were stopped by Watchtower itself
WATCHTOWER_REVIVE_STOPPED=false

# Remove anonymous volumes when updating containers
WATCHTOWER_REMOVE_VOLUMES=false

# Include containers in a restarting state
WATCHTOWER_INCLUDE_RESTARTING=false

# ── Scope / Filtering ───────────────────────────────────────────────────────
# Filter label for scoped updates (leave empty for all containers)
# WATCHTOWER_SCOPE=mygroup

# Only update containers with com.centurylinklabs.watchtower.enable=true label
WATCHTOWER_LABEL_ENABLE=false

# Only monitor for updates, do not actually perform them
WATCHTOWER_MONITOR_ONLY=false

# ── Rolling Restart ─────────────────────────────────────────────────────────
# Restart containers one at a time
WATCHTOWER_ROLLING_RESTART=false

# Wait duration before stopping a container (e.g. 10s, 1m)
WATCHTOWER_TIMEOUT=10s

# ── Registry Credentials ────────────────────────────────────────────────────
REPO_USER=myregistryuser
REPO_PASS=sup3rs3cr3tpassw0rd

# ── Notifications ────────────────────────────────────────────────────────────
# Notification backends: slack, email, msteams, gotify, shoutrrr
WATCHTOWER_NOTIFICATIONS=slack

# Generic shoutrrr notification URL (may contain credentials)
# WATCHTOWER_NOTIFICATION_URL=slack://token:channel@webhook

# Slack webhook URL (kept secret)
WATCHTOWER_SLACK_HOOK_URL=https://hooks.slack.com/services/T000/B000/XXXXXXXXXXXX

# Email notification settings
# WATCHTOWER_NOTIFICATION_EMAIL_SERVER=smtp.example.com
# WATCHTOWER_NOTIFICATION_EMAIL_FROM=watchtower@example.com
# WATCHTOWER_NOTIFICATION_EMAIL_TO=admin@example.com
# WATCHTOWER_NOTIFICATION_EMAIL_SERVER_PASSWORD=emailpassword

# ── HTTP API ────────────────────────────────────────────────────────────────
# Enable the HTTP API endpoint for triggering updates
WATCHTOWER_HTTP_API_UPDATE=false

# API token (required when HTTP API is enabled)
# WATCHTOWER_HTTP_API_TOKEN=my-secret-api-token

# Allow periodic polls even when HTTP API is enabled
WATCHTOWER_HTTP_API_PERIODIC_POLLS=false

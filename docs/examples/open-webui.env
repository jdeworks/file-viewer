# Open WebUI Environment Configuration
# Self-hosted AI chat interface for Ollama / OpenAI

# Server
WEBUI_URL=https://chat.example.com
PORT=3000
WEBUI_NAME=My AI Assistant

# Backend
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_BASE_URLS=http://ollama-1:11434;http://ollama-2:11434
OPENAI_API_BASE_URL=https://api.openai.com/v1

# Security
WEBUI_SECRET_KEY=supersecret-key-abc123xyz
WEBUI_AUTH=true
ENABLE_SIGNUP=false
ENABLE_LOGIN_FORM=true

# API Keys
OPENAI_API_KEY=sk-proj-examplekey1234567890abcdef
ANTHROPIC_API_KEY=sk-ant-examplekey1234567890abcdef

# Database
DATABASE_URL=postgresql://webui_user:dbpassword123@db:5432/openwebui

# RAG (Retrieval)
ENABLE_RAG_WEB_SEARCH=true
RAG_EMBEDDING_ENGINE=ollama
CHUNK_SIZE=1500
CHUNK_OVERLAP=100

# LDAP / OAuth
ENABLE_OAUTH_SIGNUP=true
OAUTH_CLIENT_ID=my-oauth-client-id
OAUTH_CLIENT_SECRET=my-oauth-client-secret
OAUTH_PROVIDER_NAME=Google

# Storage
STORAGE_PROVIDER=s3
S3_BUCKET_NAME=my-webui-bucket
S3_ACCESS_KEY=AKIAEXAMPLEACCESSKEY
S3_SECRET_KEY=example/secret/key+abc123

# Admin
DEFAULT_USER_ROLE=user
ADMIN_EMAIL=admin@example.com

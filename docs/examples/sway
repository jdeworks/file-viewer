# Sway config file (~/.config/sway/config)
# See sway(5) for reference

set $mod Mod4
set $term kitty
set $menu wofi --show drun

# Font
font pango:JetBrains Mono 10

# Output configuration
output HDMI-A-1 resolution 2560x1440 position 0,0 scale 1
output eDP-1 resolution 1920x1080 position 2560,180 scale 1.5

# Wallpaper
output * bg /usr/share/backgrounds/sway/Sway_Wallpaper_Blue_1920x1080.png fill

# Idle configuration
exec swayidle -w \
    timeout 300 'swaylock -f -c 000000' \
    timeout 600 'swaymsg "output * dpms off"' \
    resume 'swaymsg "output * dpms on"' \
    before-sleep 'swaylock -f -c 000000'

# Input configuration
input "type:keyboard" {
    xkb_layout us
    xkb_options caps:escape
    repeat_delay 300
    repeat_rate 50
}

input "type:touchpad" {
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
    scroll_method two_finger
    pointer_accel 0.3
}

# Key bindings
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+Shift+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway?' -B 'Yes, exit sway' 'swaymsg exit'

# Focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2

# Layout
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle

# Gaps
gaps inner 8
gaps outer 4
smart_gaps on
smart_borders on

# Bar
bar {
    swaybar_command waybar
}

# Startup
exec --no-startup-id nm-applet --indicator
exec_always --no-startup-id pkill kanshi; kanshi

# wget default configuration

# Network
timeout = 30
connect-timeout = 10
dns-timeout = 10
tries = 3
wait = 1
waitretry = 10
follow_ftp = on
passive_ftp = on

# HTTP
user_agent = Mozilla/5.0 (compatible; wget/1.21.4)
cookies = on
keep_session_cookies = on
content_disposition = on
server_response = off

# Authentication (values masked in viewer)
http_user = wgetuser
http_passwd = secretpass

# Proxy
http_proxy = http://proxy.corp.example.com:3128
https_proxy = http://proxy.corp.example.com:3128
no_proxy = localhost,127.0.0.1,.corp.example.com

# Output / download behavior
verbose = off
quiet = off
timestamping = on
continue = on
progress = bar

# Security
check_certificate = on

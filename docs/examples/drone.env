# Drone CI Server Configuration
# https://docs.drone.io/server/reference/

# Server
DRONE_SERVER_HOST=drone.example.com
DRONE_SERVER_PROTO=https
DRONE_SERVER_PORT=443

# RPC secret shared with all runners/agents
DRONE_RPC_SECRET=bGV0bWVpbnRoZXJlc2VjcmV0a2V5MTIzNDU2Nzg=

# GitHub OAuth application
DRONE_GITHUB_CLIENT_ID=Iv1.a1b2c3d4e5f6g7h8
DRONE_GITHUB_CLIENT_SECRET=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2

# Database backend (sqlite3 is fine for small installs)
DRONE_DATABASE_DRIVER=sqlite3
DRONE_DATABASE_DATASOURCE=/data/database.sqlite

# Logging
DRONE_LOGS_DEBUG=false
DRONE_LOGS_PRETTY=false

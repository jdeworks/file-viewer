SECRET_KEY=super-secret-key-change-in-production
DATABASE_URL=postgres://glitchtip:password@db:5432/glitchtip
REDIS_URL=redis://redis:6379/0
EMAIL_URL=smtp://user:password@smtp.example.com:587
DEFAULT_FROM_EMAIL=noreply@glitchtip.example.com
GLITCHTIP_DOMAIN=https://glitchtip.example.com
CELERY_WORKER_CONCURRENCY=2
ENABLE_OPEN_USER_REGISTRATION=True
ORGANIZATION_CREATION_OPEN=True
GITHUB_AUTH_KEY=your-github-client-id
GITHUB_AUTH_SECRET=your-github-client-secret
GOOGLE_AUTH_KEY=your-google-client-id
GOOGLE_AUTH_SECRET=your-google-client-secret
MICROSOFT_AUTH_KEY=your-microsoft-client-id
MICROSOFT_AUTH_SECRET=your-microsoft-client-secret
MAX_EVENT_LIFE_DAYS=90

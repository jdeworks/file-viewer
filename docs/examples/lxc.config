# LXC container configuration

lxc.uts.name = mycontainer
lxc.arch = linux64
lxc.rootfs.path = dir:/var/lib/lxc/mycontainer/rootfs
lxc.rootfs.options = bind,rw

# Network
lxc.net.0.type = veth
lxc.net.0.link = lxcbr0
lxc.net.0.flags = up
lxc.net.0.name = eth0
lxc.net.0.hwaddr = 00:16:3e:aa:bb:cc
lxc.net.0.ipv4.address = 10.0.3.100/24
lxc.net.0.ipv4.gateway = 10.0.3.1

lxc.net.1.type = macvlan
lxc.net.1.link = eth0
lxc.net.1.macvlan.mode = bridge
lxc.net.1.flags = up

# Resource limits
lxc.cgroup.cpu.shares = 1024
lxc.cgroup2.cpu.max = 200000 100000
lxc.cgroup2.memory.max = 2147483648
lxc.cgroup2.memory.swap.max = 536870912

# Mount entries
lxc.mount.auto = proc:mixed sys:ro cgroup:mixed
lxc.mount.entry = /srv/shared srv/shared none bind,ro 0 0
lxc.mount.entry = tmpfs tmp tmpfs size=512m 0 0

# User namespace mappings
lxc.idmap = u 0 100000 65536
lxc.idmap = g 0 100000 65536

# Security
lxc.cap.drop = sys_module mac_admin mac_override sys_time
lxc.seccomp.profile = /etc/lxc/common.seccomp
lxc.apparmor.profile = lxc-container-default-cgns

# Console
lxc.console.logfile = /var/log/lxc/mycontainer.log
lxc.tty.max = 4

# Init
lxc.init.cmd = /sbin/init

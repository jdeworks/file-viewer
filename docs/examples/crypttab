# /etc/crypttab: encrypted device configuration
# <name>      <device>                                  <key-file>   <options>

# Root LUKS partition (prompted for password at boot)
cryptroot   UUID=11111111-2222-3333-4444-555555555555  none         luks,discard

# Separate data partition using a keyfile
cryptdata   UUID=66666666-7777-8888-9999-aaaaaaaaaaaa  /etc/luks/data.key  luks,discard,tries=3

# Detached header (header stored separately from data)
cryptbackup  /dev/sdb1  /etc/luks/backup.key  luks,header=/etc/luks/backup-header.img

# Swap encryption (new key on every boot)
cryptswap   /dev/sda3   /dev/urandom  swap,offset=8,cipher=aes-xts-plain64,size=256

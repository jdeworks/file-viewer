# USB storage devices
SUBSYSTEM=="usb", ATTRS{idVendor}=="0781", ATTRS{idProduct}=="5583", MODE="0666", GROUP="plugdev"

# YubiKey
SUBSYSTEM=="usb", ATTRS{idVendor}=="1050", ATTRS{idProduct}=="0407", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# Nintendo Switch in RCM mode
SUBSYSTEM=="usb", ATTRS{idVendor}=="0955", ATTRS{idProduct}=="7321", MODE="0666"

# Persistent network interface names
SUBSYSTEM=="net", ACTION=="add", KERNELS=="0000:02:00.0", ATTR{address}=="aa:bb:cc:dd:ee:ff", NAME="eth0"

# udev rules for /dev/ttyUSB* permissions
KERNEL=="ttyUSB[0-9]*", MODE="0666", GROUP="dialout"
KERNEL=="ttyACM[0-9]*", MODE="0666", GROUP="dialout"

# Run a script when USB connected
ACTION=="add", SUBSYSTEM=="usb", RUN+="/usr/local/bin/usb-inserted.sh"

# Power management
SUBSYSTEM=="pci", ATTR{power/control}="auto"

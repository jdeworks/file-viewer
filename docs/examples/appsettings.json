{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=MyApp;User Id=appuser;Password=secret123;",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://myapp.example.com",
    "Audience": "https://myapp.example.com",
    "ExpiryMinutes": 60
  },
  "Features": {
    "EnableDarkMode": true,
    "BetaFeatures": false
  }
}

{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.10.7/.schema/devbox.schema.json",
  "devbox_version": "0.10.7",
  "packages": [
    "nodejs@18.20.3",
    "python@3.11.9",
    "postgresql@15.6",
    "git",
    "ripgrep"
  ],
  "shell": {
    "init_hook": [
      "echo 'Devbox environment ready. Run `devbox run dev` to start.'",
      "export PATH=\"$PWD/node_modules/.bin:$PATH\""
    ],
    "env": {
      "NODE_ENV": "development",
      "DATABASE_URL": "postgres://localhost/myapp",
      "SECRET_KEY": "super-secret-value",
      "PORT": "3000"
    },
    "scripts": {
      "dev": "node server.js",
      "test": "npm test",
      "db:start": "pg_ctl start -D $PGDATA -l $PGDATA/postgresql.log",
      "lint": "npx eslint ."
    }
  }
}

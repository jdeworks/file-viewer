MEMOS_PORT=5230
MEMOS_ADDR=0.0.0.0
MEMOS_PUBLIC_URL=https://memos.example.com
MEMOS_MODE=prod

MEMOS_DRIVER=sqlite
MEMOS_DSN=/var/opt/memos/memos_prod.db

MEMOS_SECRET_SESSION_KEY=your-session-secret-key-here
MEMOS_DISABLE_PASSWORD_LOGIN=false
MEMOS_METRIC=false

MEMOS_ADDITIONAL_SCRIPT=

# npm registry configuration
registry=https://registry.npmjs.org/

# Scope-specific registries
@company:registry=https://npm.company.internal/

# Cache settings
cache=~/.npm
prefer-offline=false

# Install behaviour
save-exact=true
legacy-peer-deps=false
fund=false
audit=true

# Auth (redacted in viewer)
//npm.company.internal/:_authToken=npm_secrettoken123
//registry.npmjs.org/:_authToken=npm_publictoken456

# Proxy (if needed)
# https-proxy=http://proxy.company.com:8080

ninja_required_version = 1.5

cc = gcc
cflags = -Wall -O2

rule cc_compile
  command = $cc $cflags -c $in -o $out
  description = CC $out

rule cc_link
  command = $cc -o $out $in $libs
  description = LINK $out

build src/main.o: cc_compile src/main.c
build src/utils.o: cc_compile src/utils.c
build src/app.o: cc_compile src/app.c

build myapp: cc_link src/main.o src/utils.o src/app.o
  libs = -lm

default myapp

# curl default configuration

# Follow redirects
location
max-redirs = 10

# Retry
retry = 3
retry-delay = 2
retry-max-time = 60

# Timeouts
max-time = 30
connect-timeout = 10

# HTTP
compressed
http2
user-agent = Mozilla/5.0 (compatible; curl/8.5.0)

# Extra headers
header = "Accept-Language: en-US,en;q=0.9"

# Security
capath = /etc/ssl/certs/

# Progress / output
silent
show-error

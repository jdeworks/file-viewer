# Plausible Analytics Self-Hosted Configuration
# https://plausible.io/docs/self-hosting-configuration

BASE_URL=https://plausible.example.com
SECRET_KEY_BASE=VeryLongAndSecretKeyBase64EncodedStringHerePleaseChangeThis1234567890
DISABLE_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=false

# Database
DATABASE_URL=postgres://plausible:dbpassword@localhost:5432/plausible_db
CLICKHOUSE_DATABASE_URL=http://clickhouse:chpassword@localhost:8123/plausible_events_db

# Email / SMTP
MAILER_EMAIL=no-reply@example.com
SMTP_HOST_ADDR=smtp.example.com
SMTP_HOST_PORT=587
SMTP_USER_NAME=smtp-user@example.com
SMTP_USER_PWD=smtppassword123
SMTP_HOST_SSL_ENABLED=true

# Google OAuth (optional, for Google Search Console integration)
GOOGLE_CLIENT_ID=123456789-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-verysecretclientsecretvalue

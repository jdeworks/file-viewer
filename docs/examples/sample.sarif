              }
            },
            {
              "id": "AUTH008",
              "name": "MissingAuthCheck",
              "shortDescription": {
                "text": "Endpoint lacks an authorization check"
              }
            },
            {
              "id": "LOG009",
              "name": "SensitiveDataLog",
              "shortDescription": {
                "text": "Sensitive data written to logs"
              }
            },
            {
              "id": "CFG010",
              "name": "InsecureConfig",
              "shortDescription": {
                "text": "Insecure default configuration value"
              }
            }
          ]
        }

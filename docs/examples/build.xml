<?xml version="1.0" encoding="UTF-8"?>
<project name="MyApp" default="package" basedir=".">
  <description>Apache Ant build for MyApp</description>

  <!-- Properties -->
  <property name="src.dir" value="src"/>
  <property name="build.dir" value="build"/>
  <property name="dist.dir" value="dist"/>
  <property name="lib.dir" value="lib"/>
  <property name="main.class" value="com.example.Main"/>
  <property name="version" value="1.0.0"/>

  <!-- Class path -->
  <path id="classpath">
    <fileset dir="${lib.dir}" includes="*.jar"/>
    <pathelement path="${build.dir}/classes"/>
  </path>

  <!-- Targets -->
  <target name="init">
    <mkdir dir="${build.dir}/classes"/>
    <mkdir dir="${dist.dir}"/>
  </target>

  <target name="compile" depends="init" description="Compile source files">
    <javac srcdir="${src.dir}"
           destdir="${build.dir}/classes"
           includeantruntime="false"
           classpathref="classpath"/>
  </target>

  <target name="test" depends="compile" description="Run unit tests">
    <junit printsummary="yes" haltonfailure="yes">
      <classpath refid="classpath"/>
      <batchtest fork="yes" todir="${build.dir}/reports">
        <fileset dir="${src.dir}" includes="**/*Test.java"/>
      </batchtest>
    </junit>
  </target>

  <target name="package" depends="test" description="Create distribution JAR">
    <jar destfile="${dist.dir}/myapp-${version}.jar"
         basedir="${build.dir}/classes">
      <manifest>
        <attribute name="Main-Class" value="${main.class}"/>
        <attribute name="Implementation-Version" value="${version}"/>
      </manifest>
      <zipgroupfileset dir="${lib.dir}" includes="*.jar"/>
    </jar>
  </target>

  <target name="clean" description="Remove build artifacts">
    <delete dir="${build.dir}"/>
    <delete dir="${dist.dir}"/>
  </target>
</project>

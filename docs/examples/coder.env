# Coder deployment configuration
# https://coder.com/docs/v2/latest/admin/configure

CODER_ACCESS_URL=https://coder.example.com
CODER_WILDCARD_ACCESS_URL=*.coder.example.com
CODER_HTTP_ADDRESS=0.0.0.0:3000

# TLS
CODER_TLS_ENABLE=true
CODER_TLS_CERT_FILE=/etc/certs/coder.crt
CODER_TLS_KEY_FILE=/etc/certs/coder.key

# Database
CODER_PG_CONNECTION_URL=postgresql://coder:supersecretpassword@localhost:5432/coder

# Prometheus
CODER_PROMETHEUS_ENABLE=true
CODER_PROMETHEUS_ADDRESS=0.0.0.0:2112

# Telemetry
CODER_TELEMETRY=false

# GitHub OAuth2
CODER_OAUTH2_GITHUB_CLIENT_ID=Iv1.abcdef1234567890
CODER_OAUTH2_GITHUB_CLIENT_SECRET=abcdef1234567890abcdef1234567890abcdef12

# OIDC
CODER_OIDC_ISSUER_URL=https://accounts.google.com
CODER_OIDC_CLIENT_ID=123456789-abcdefgh.apps.googleusercontent.com
CODER_OIDC_CLIENT_SECRET=GOCSPX-abcdefghijklmnopqrstuvwxyz

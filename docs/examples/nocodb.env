## NocoDB Configuration
## https://docs.nocodb.com/getting-started/self-hosted/environment-variables

## Server
NC_PUBLIC_URL=https://nocodb.example.com
PORT=8080

## Security
NC_AUTH_JWT_SECRET=secret-jwt-token-for-nocodb-auth

## Database
NC_DB=pg://localhost:5432?u=nocodb&p=password&d=nocodb_db

## Redis (for caching / real-time)
NC_REDIS_URL=redis://:redispassword@localhost:6379

## Email / SMTP
NC_SMTP_HOST=smtp.example.com
NC_SMTP_PORT=587
NC_SMTP_FROM=nocodb@example.com
NC_SMTP_SENDER_NAME=NocoDB
NC_SMTP_USERNAME=nocodb@example.com
NC_SMTP_PASSWORD=smtppassword789

## Features
NC_DISABLE_TELE=true
NC_INVITE_ONLY_SIGNUP=true
NC_TOOL_DIR=/opt/nocodb

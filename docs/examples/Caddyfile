# Global options
{
    email admin@example.com
    admin off
    servers {
        protocols h1 h2 h3
    }
}

# Main website
example.com {
    root * /var/www/html
    file_server
    encode gzip zstd
    tls admin@example.com
    log {
        output file /var/log/caddy/access.log
        format json
    }
    header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
}

# API reverse proxy
api.example.com {
    reverse_proxy localhost:8080 {
        header_up Host {upstream_hostport}
        health_uri /health
        health_interval 10s
    }
    tls admin@example.com
    log {
        output file /var/log/caddy/api.log
    }
}

# Redirect www to non-www
www.example.com {
    redir https://example.com{uri} permanent
}

# Local dev with internal TLS
localhost:8443 {
    root * /home/dev/project/public
    file_server browse
    tls internal
    encode gzip
}

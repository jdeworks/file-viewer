## Hoppscotch Configuration
## https://docs.hoppscotch.io/documentation/self-host/community-edition/env-variables

DATABASE_URL=postgresql://hoppscotch:secretpassword@localhost:5432/hoppscotch

## Authentication tokens
JWT_SECRET=your-super-secret-jwt-key-here
TOKEN_SALT_COMPLEXITY=10
MAGIC_LINK_TOKEN_VALIDITY=3
REFRESH_TOKEN_VALIDITY=604800000
ACCESS_TOKEN_VALIDITY=86400000
SESSION_SECRET=add-a-random-string-here

## URLs
REDIRECT_URL=https://hoppscotch.example.com
WHITELISTED_ORIGINS=https://hoppscotch.example.com,https://admin.hoppscotch.example.com
VITE_ALLOWED_AUTH_PROVIDERS=GOOGLE,GITHUB,MICROSOFT,EMAIL

## Email / SMTP
MAILER_SMTP_HOST=smtp.example.com
MAILER_SMTP_PORT=587
MAILER_SMTP_USER=hoppscotch@example.com
MAILER_SMTP_PASSWORD=smtp-password-here
MAILER_ADDRESS_FROM="Hoppscotch <hoppscotch@example.com>"

## Google OAuth
GOOGLE_CLIENT_ID=123456789-abcdefghijklmnop.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-example-secret

## GitHub OAuth
GITHUB_CLIENT_ID=Iv1.abc123def456
GITHUB_CLIENT_SECRET=github-oauth-secret-here

## Microsoft OAuth
MICROSOFT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MICROSOFT_CLIENT_SECRET=microsoft-secret-value-here

{
  "title": "Node Exporter Dashboard",
  "uid": "node-exporter-01",
  "schemaVersion": 36,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "tags": ["prometheus", "node-exporter"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(up, job)"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU Usage",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "100 - (avg(rate(node_cpu_seconds_total{job=\"$job\",mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU %"
        }
      ]
    },
    {
      "id": 2,
      "title": "Memory Usage Over Time",
      "type": "graph",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "(1 - node_memory_MemAvailable_bytes{job=\"$job\"} / node_memory_MemTotal_bytes{job=\"$job\"}) * 100",
          "legendFormat": "Memory %"
        }
      ]
    },
    {
      "id": 3,
      "title": "Network Traffic",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{job=\"$job\",device!=\"lo\"}[5m])",
          "legendFormat": "rx {{ device }}"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total{job=\"$job\",device!=\"lo\"}[5m])",
          "legendFormat": "tx {{ device }}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Disk Usage",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "100 - ((node_filesystem_avail_bytes{job=\"$job\",fstype!=\"tmpfs\"} * 100) / node_filesystem_size_bytes{job=\"$job\",fstype!=\"tmpfs\"})",
          "legendFormat": "{{ mountpoint }}"
        }
      ]
    }
  ]
}

# Infisical Secrets Management Platform Environment Configuration
# https://infisical.com/docs/self-hosting/overview

# Server
SITE_URL=https://infisical.example.com
INVITE_ONLY_SIGNUP=false
TELEMETRY_ENABLED=true

# Security / Encryption
ENCRYPTION_KEY=eb9f9a26f4c4f1d3c45e8b2a7f6e2d1c3b8a7f6e2d1c3b8a7f6e2d1c3b8a7f6
AUTH_SECRET=your_auth_secret_here_minimum_32_chars_long_xxxxxxxxxxx
JWT_AUTH_SECRET=your_jwt_auth_secret_here_minimum_32_chars_long
JWT_MFA_SECRET=your_jwt_mfa_secret_here_minimum_32_chars_long_xxxxx
JWT_SERVICE_SECRET=your_jwt_service_secret_here_minimum_32_chars_long

# Database (MongoDB)
MONGO_URL=mongodb://infisical:mongopassword@mongo:27017/infisical?authSource=admin

# Redis
REDIS_URL=redis://:redispassword@redis:6379

# SMTP Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=smtpsecretpassword

APP_PORT=22300
APP_BASE_URL=https://joplin.example.com
JOPLIN_BASE_URL=https://joplin.example.com
NODE_ENV=production

DB_CLIENT=pg
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=joplin
DB_USER=joplin
DB_PASSWORD=secret_db_password

MAILER_ENABLED=1
MAILER_HOST=smtp.example.com
MAILER_PORT=587
MAILER_SECURITY=tls
MAILER_FROM=noreply@example.com
MAILER_AUTH_USER=noreply@example.com
MAILER_AUTH_PASSWORD=smtp_password

STORAGE_DRIVER=filesystem
STORAGE_FILESYSTEM_PATH=/data/joplin

SECRET_KEY=a_very_long_secret_key_here
MAX_TIME_DRIFT=60000

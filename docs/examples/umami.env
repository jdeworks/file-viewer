# Umami Analytics Self-Hosted Configuration
# https://umami.is/docs/environment-variables

DATABASE_URL=postgresql://umami:umamipassword@localhost:5432/umami_db
APP_SECRET=random-secret-string-change-this-in-production

# Server
HOSTNAME=analytics.example.com
PORT=3000
FORCE_SSL=true

# Access control
DISABLE_LOGIN=false

# Privacy
DISABLE_TELEMETRY=true
IGNORE_IP=192.168.1.1,10.0.0.1
CLIENT_IP_HEADER=X-Forwarded-For

# Embed / framing
ALLOWED_FRAME_URLS=https://example.com https://app.example.com

{
  "type": "record",
  "name": "User",
  "namespace": "com.example.avro",
  "doc": "A registered user record",
  "fields": [
    { "name": "id", "type": "long", "doc": "Unique user identifier" },
    { "name": "username", "type": "string" },
    { "name": "email", "type": "string", "doc": "Primary email address" },
    { "name": "created_at", "type": "long", "doc": "Unix timestamp of registration" },
    { "name": "is_active", "type": "boolean", "default": true },
    { "name": "score", "type": ["null", "double"], "default": null, "doc": "Optional engagement score" },
    { "name": "role", "type": {
      "type": "enum",
      "name": "UserRole",
      "symbols": ["ADMIN", "USER", "MODERATOR"]
    }},
    { "name": "address", "type": ["null", {
      "type": "record",
      "name": "Address",
      "fields": [
        { "name": "street", "type": "string" },
        { "name": "city", "type": "string" },
        { "name": "country", "type": "string" },
        { "name": "postal_code", "type": ["null", "string"], "default": null }
      ]
    }], "default": null },
    { "name": "tags", "type": { "type": "array", "items": "string" }, "default": [] }
  ]
}

(set-logic QF_LIA)
(set-option :produce-models true)
(set-option :print-success false)
(declare-const x Int)
(declare-const y Int)
(declare-fun max (Int Int) Int)
(assert (>= x 0))
(assert (>= y 0))
(assert (= (max x y) (ite (>= x y) x y)))
(assert (< (max x y) 100))
(check-sat)
(get-model)
(get-value (x y))

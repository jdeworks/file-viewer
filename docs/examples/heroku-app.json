{
  "name": "my-web-api",
  "description": "REST API service with background job processing and PostgreSQL storage.",
  "website": "https://my-web-api.example.com",
  "repository": "https://github.com/example/my-web-api",
  "stack": "heroku-22",
  "buildpacks": [
    { "url": "heroku/nodejs" },
    { "url": "heroku/python" }
  ],
  "formation": {
    "web": {
      "quantity": 1,
      "size": "Standard-1X"
    },
    "worker": {
      "quantity": 1,
      "size": "Standard-1X"
    }
  },
  "addons": [
    { "plan": "heroku-postgresql:standard-0" },
    { "plan": "heroku-redis:premium-0" },
    { "plan": "papertrail:choklad" }
  ],
  "env": {
    "NODE_ENV": {
      "description": "Application runtime environment.",
      "value": "production"
    },
    "DATABASE_POOL_SIZE": {
      "description": "Number of database connections in the pool.",
      "value": "10"
    },
    "SECRET_KEY_BASE": {
      "description": "Secret key for signing session cookies.",
      "generator": "secret"
    },
    "API_TOKEN": {
      "description": "Token for authenticating with the upstream API.",
      "required": true
    },
    "REDIS_URL": {
      "description": "Redis connection URL (set automatically by heroku-redis add-on)."
    },
    "LOG_LEVEL": {
      "description": "Logging verbosity.",
      "value": "info"
    }
  },
  "scripts": {
    "postdeploy": "node scripts/migrate.js && node scripts/seed-config.js",
    "pr-predestroy": "node scripts/cleanup-preview.js"
  },
  "environments": {
    "test": {
      "addons": ["heroku-postgresql:mini"],
      "env": {
        "NODE_ENV": { "value": "test" }
      },
      "scripts": {
        "test-setup": "node scripts/setup-test-db.js"
      }
    }
  }
}

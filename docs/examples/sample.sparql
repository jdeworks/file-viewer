# SPARQL query: Find books with their authors and publication years
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dc:   <http://purl.org/dc/elements/1.1/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX ex:   <http://example.org/books/>

SELECT DISTINCT ?title ?author ?year
WHERE {
  ?book rdf:type ex:Book .
  ?book dc:title ?title .
  ?book dc:creator ?author .
  OPTIONAL {
    ?book dc:date ?year .
    FILTER(?year > "1990"^^xsd:integer)
  }
  FILTER(LANG(?title) = "en" || LANG(?title) = "")
}
GROUP BY ?title ?author ?year
ORDER BY ASC(?year) DESC(?title)
LIMIT 100

{
  "test": {
    "environment": "jsdom",
    "globals": true,
    "include": ["src/**/*.{test,spec}.{js,ts,jsx,tsx}"],
    "exclude": ["node_modules", "dist", "e2e/**"],
    "reporters": ["verbose", "html"],
    "testTimeout": 10000,
    "coverage": {
      "provider": "v8",
      "reporter": ["text", "lcov"],
      "thresholds": {
        "lines": 80,
        "branches": 75,
        "functions": 80,
        "statements": 80
      }
    }
  }
}

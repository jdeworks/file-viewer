# EditorConfig is awesome: https://EditorConfig.org
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{js,ts,jsx,tsx,mjs,cjs}]
indent_size = 2
max_line_length = 100

[*.py]
indent_size = 4
max_line_length = 88

[*.{rs}]
indent_size = 4
max_line_length = 100

[*.{go}]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{bat,cmd}]
end_of_line = crlf

[*.{sh,bash}]
end_of_line = lf
